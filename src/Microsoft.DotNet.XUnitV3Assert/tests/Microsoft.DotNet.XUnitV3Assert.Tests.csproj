<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TestRunnerName>XUnitV3</TestRunnerName>
    <IsTestProject>false</IsTestProject>

    <NoWarn>$(NoWarn);xUnit1013;xUnit1008;IDE0073</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Microsoft.DotNet.XUnitV3Assert.csproj" />
    <PackageReference Include="NSubstitute" Version="$(NSubstituteVersion)" />
    <PackageReference Include="xunit.v3.core" Version="$(XUnitV3Version)" IsImplicitlyDefined="true" />
    <PackageReference Remove="xunit.v3.assert" />
  </ItemGroup>

</Project>
